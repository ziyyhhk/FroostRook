{
  "name": "froostrook",
  "version": "1.0.3-beta",
  "private": true,
  "description": "FroostRook 1.0.3 Beta: from-scratch chess engine with C++17 search core, JavaScript front-end, opening personalities, human move prediction and PGN analysis",
  "scripts": {
    "play": "node play.js",
    "uci": "node uci.js",
    "build:native": "native/build.bat",
    "test": "node test/perft.js && node test/bench.js",
    "test:all": "node test/perft.js && node test/perft-native.js && node test/rules.js && node test/book-check.js && node test/prediction.js && node test/uci-smoke.js && node test/stop-test.js && node test/ponder-test.js && node test/openings-native.js 20 6 && node test/book-fallback.js && node test/analyze-test.js",
    "test:native": "node test/perft-native.js && node test/wac-native.js 300 300",
    "test:rules": "node test/rules.js",
    "test:uci": "node test/uci-smoke.js",
    "test:stop": "node test/stop-test.js",
    "test:book": "node test/book-check.js && node test/book-fallback.js",
    "test:openings": "node test/openings-native.js",
    "test:predict": "node test/prediction.js",
    "test:threads": "node test/thread-bench.js",
    "predict": "node test/predict.js",
    "predict:fit": "node test/fit-predict.js",
    "predict:accuracy": "node test/predict-accuracy.js",
    "predict:data": "node test/fetch-human-games.js --parse-only && node test/train-priors.js",
    "wac": "node test/wac.js 300 300",
    "book": "node test/gen-book.js && node test/gen-native-book.js",
    "book:native": "node test/gen-native-book.js",
    "elo": "node test/elo.js",
    "analyze": "node analyze.js",
    "test:analyze": "node test/analyze-test.js",
    "match:native": "node test/match-native.js 100 10",
    "test:ponder": "node test/ponder-test.js"
  }
}
