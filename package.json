{
  "name": "kiwa-chess",
  "version": "2.0.1",
  "private": true,
  "description": "From-scratch chess engine: C++17 search core, JavaScript front-end, opening book and human move prediction",
  "scripts": {
    "play": "node play.js",
    "uci": "node uci.js",
    "build:native": "native/build.bat",
    "test": "node test/perft.js && node test/bench.js",
    "test:native": "node test/perft-native.js && node test/wac-native.js 300 300",
    "match:native": "node test/match-native.js 100 10",
    "elo": "node test/elo.js",
    "test:uci": "node test/uci-smoke.js",
    "test:book": "node test/book-check.js",
    "predict": "node test/predict.js",
    "wac": "node test/wac.js 300 300",
    "book": "node test/gen-book.js"
  }
}
